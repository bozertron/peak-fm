# ---------------------------------------------------------------------------
# Peak — environment template
# Copy to `.env.local` (gitignored) and fill in real values.
# ---------------------------------------------------------------------------

# Postgres connection string used by `lib/db/index.ts` (node-postgres Pool)
# and by Better Auth, which is handed that same pool in `lib/auth.ts`.
DATABASE_URL=postgres://peak:peak@127.0.0.1:5432/peak

# Required by Better Auth to sign sessions. Without it the server throws
# "You are using the default secret" on every request that touches auth.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. REQUIRED IN EVERY ENVIRONMENT.
#
# Better Auth uses it for callbacks and redirects, and since PEAK-204 it is
# also added to `trustedOrigins`. Before that fix, production trusted only
# Vercel-derived URLs, so any other host had NO trusted origin and every auth
# call returned 403 INVALID_ORIGIN. It must match the origin the browser
# actually uses — http://localhost:3000 and http://127.0.0.1:3000 are
# different origins to Better Auth.
BETTER_AUTH_URL=http://localhost:3000
